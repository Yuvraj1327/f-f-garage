# Copy to `.env` (same folder) and fill in real values. `.env` is git-ignored.
# Never commit real keys. Never copy the service-role key or payment secrets
# into the Flutter app.

# ---- App --------------------------------------------------------------------
APP_NAME=F&F Two Wheeler Garage API
# One of: development, test, staging, production
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
# Serves Swagger UI at /docs and ReDoc at /redoc. Set to false to hide them.
ENABLE_DOCS=true
# Comma-separated browser origins allowed by CORS (needed by the admin web
# panel in a later phase; the mobile app does not use CORS). '*' is rejected
# when APP_ENV=production.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Flutter Web's dev server picks a random port, so in development any
# http://localhost:<port> / http://127.0.0.1:<port> origin is also accepted.
# Set to false to allow only CORS_ORIGINS.
CORS_ALLOW_LOCAL_DEV_ORIGINS=true

# ---- Supabase ---------------------------------------------------------------
# Project URL, e.g. https://abcdefghijklmnop.supabase.co
SUPABASE_URL=
# Public anon key (also used by the Flutter app, by design).
SUPABASE_ANON_KEY=
# SECRET: bypasses Row Level Security. Backend only.
SUPABASE_SERVICE_ROLE_KEY=
# Leave blank if your project uses asymmetric JWT signing keys (the default for
# new projects): tokens are then verified against the project's public JWKS.
# Set it ONLY for older projects that still use the legacy shared HS256 secret.
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated

# ---- Driver accounts --------------------------------------------------------
# Drivers sign in with an ID + password. Supabase Auth needs an email, so each
# driver gets <driver_id>@<this domain>. The reserved ".invalid" TLD guarantees
# no email can ever be delivered there. Must match the database function
# public.driver_email_domain() and the Flutter app default.
DRIVER_EMAIL_DOMAIN=drivers.ffgarage.invalid

# ---- Payment gateway (Phase 5) ---------------------------------------------
# Leave PAYMENT_GATEWAY_PROVIDER empty to switch online payments off (bookings still
# work, the app just cannot take payment). Use "razorpay" to switch them on.
# Everything below is backend-only configuration; none of it goes into the Flutter app.
PAYMENT_GATEWAY_PROVIDER=
# Razorpay Dashboard > Account & Settings > API keys. rzp_test_... = sandbox,
# rzp_live_... = real money.
PAYMENT_GATEWAY_KEY_ID=
PAYMENT_GATEWAY_KEY_SECRET=
# Razorpay Dashboard > Webhooks: the secret you type when creating the webhook.
# It is NOT the API key secret. Required in production.
PAYMENT_GATEWAY_WEBHOOK_SECRET=
PAYMENT_GATEWAY_BASE_URL=https://api.razorpay.com/v1
PAYMENT_GATEWAY_TIMEOUT_SECONDS=10
# Name shown in the Razorpay checkout window.
PAYMENT_CHECKOUT_NAME=F&F Two Wheeler Garage
# An unfinished payment attempt younger than this many minutes is reused instead of
# creating a second Razorpay order.
PAYMENT_ATTEMPT_REUSE_MINUTES=30

# --- Availability (Phase 3) ---
# Time zone in which slots and dates are interpreted.
BUSINESS_TIMEZONE=Asia/Kolkata
# How many days ahead customers can book (1-365).
BOOKING_WINDOW_DAYS=30
# A slot closes for booking this many minutes before it starts.
BOOKING_LEAD_MINUTES=120

# --- Bookings (Phase 4) ---
# A customer can cancel or change a confirmed booking until this many hours before the slot.
BOOKING_CANCEL_CUTOFF_HOURS=4

# --- Garage contact / support (Phase 8) ---
# Shown on the app's Help & support screen. Leave a value empty to hide it.
GARAGE_NAME=F&F Two Wheeler Garage
GARAGE_PHONE=
GARAGE_WHATSAPP=
GARAGE_EMAIL=
GARAGE_ADDRESS=
GARAGE_HOURS=

# --- Google Maps (server side only) ---
# Used ONLY by this backend for address lookup, reverse geocoding and PIN-code
# extraction (Geocoding API). Keep it in this file, never in mobile/.env.
# In Google Cloud Console > APIs & Services > Credentials restrict this key to
#   * API restriction: "Geocoding API" only, and
#   * Application restriction: IP addresses = your server's outbound IP(s).
# It does NOT draw maps in the app; the Flutter app uses separate Maps SDK keys
# (see README, "Google Maps"). Leave empty to switch address lookup off: customers
# can still type their address and booking works as before.
GOOGLE_MAPS_API_KEY=your_server_side_maps_key
GOOGLE_MAPS_BASE_URL=https://maps.googleapis.com/maps/api
GOOGLE_MAPS_TIMEOUT_SECONDS=5
# Address lookups one customer may make per minute (protects your Google quota).
MAPS_REQUESTS_PER_MINUTE=30
