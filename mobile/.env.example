# Public configuration for the Flutter app. Copy to `.env` and fill in.
#
#   cp .env.example .env
#
# EVERYTHING IN THIS FILE IS BUNDLED INTO THE APP and can be read by anyone who
# unpacks it. Put only PUBLIC values here. NEVER add a Supabase service-role key,
# a database password, a JWT secret or a payment-gateway secret: those belong in
# backend/.env only. The app refuses to start if it finds names that look like
# secrets (SERVICE_ROLE, SECRET, PASSWORD, DATABASE_URL, JWT ...).

# Backend URL including /api/v1.
#   Android emulator -> host machine:  http://10.0.2.2:8000/api/v1
#   iOS simulator:                     http://localhost:8000/api/v1
#   Real device: your computer's LAN address or the deployed URL.
API_BASE_URL=http://10.0.2.2:8000/api/v1

# Supabase project URL and the PUBLIC anon (publishable) key only.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=YOUR-PUBLIC-ANON-KEY

# Must match DRIVER_EMAIL_DOMAIN in backend/.env (optional; this is the default).
DRIVER_EMAIL_DOMAIN=drivers.ffgarage.invalid

# ---- Google sign-in (customer "Continue with Google") ----------------------
# OAuth client IDs from Google Cloud Console > APIs & Services > Credentials.
# They are PUBLIC identifiers, not secrets. The Google client SECRET goes into
# the Supabase dashboard (Authentication > Providers > Google) and nowhere else;
# the app refuses to start if a *_SECRET name appears in this file.
# See the README, "Google sign-in", for the full setup.
#
# Web application client: also what Supabase verifies. Used on Android and iOS as
# the "server client ID", and by Supabase's redirect flow on Flutter Web.
GOOGLE_CLIENT_ID_WEB=YOUR-WEB-CLIENT-ID.apps.googleusercontent.com
# Android client: created for your package name + SHA-1 fingerprint(s).
GOOGLE_CLIENT_ID_ANDROID=YOUR-ANDROID-CLIENT-ID.apps.googleusercontent.com
# iOS client: created for your bundle ID.
GOOGLE_CLIENT_ID_IOS=YOUR-IOS-CLIENT-ID.apps.googleusercontent.com

# ---- Google Maps (map picker, booking and driver maps) ---------------------
# Maps SDK keys, one per platform. They end up inside the app, so each one MUST
# be restricted in Google Cloud Console (API restrictions: Maps SDK for
# Android / Maps SDK for iOS / Maps JavaScript API; application restrictions:
# Android package + SHA-1 / iOS bundle ID / HTTP referrers of your web site).
# These are NOT the server key: the Geocoding key for address lookup is
# GOOGLE_MAPS_API_KEY in backend/.env. Leave a key empty to switch maps off on
# that platform (the app then offers "Open in Google Maps" links instead).
# After editing, run:  python3 tool/configure_platforms.py
GOOGLE_MAPS_KEY_ANDROID=YOUR-ANDROID-MAPS-KEY
GOOGLE_MAPS_KEY_IOS=YOUR-IOS-MAPS-KEY
GOOGLE_MAPS_KEY_WEB=YOUR-WEB-MAPS-KEY
