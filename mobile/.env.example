# Public configuration for the Flutter app. Copy to `.env` and fill in.
#
#   cp .env.example .env
#
# EVERYTHING IN THIS FILE IS BUNDLED INTO THE APP and can be read by anyone who
# unpacks it. Put only PUBLIC values here. NEVER add a Supabase service-role key,
# a database password, a JWT secret or a payment-gateway secret: those belong in
# backend/.env only. The app refuses to start if it finds names that look like
# secrets (SERVICE_ROLE, SECRET, PASSWORD, DATABASE_URL, JWT ...).

# Backend URL including /api/v1.
#   Android emulator -> host machine:  http://10.0.2.2:8000/api/v1
#   iOS simulator:                     http://localhost:8000/api/v1
#   Real device: your computer's LAN address or the deployed URL.
API_BASE_URL=http://10.0.2.2:8000/api/v1

# Supabase project URL and the PUBLIC anon (publishable) key only.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=YOUR-PUBLIC-ANON-KEY

# Must match DRIVER_EMAIL_DOMAIN in backend/.env (optional; this is the default).
DRIVER_EMAIL_DOMAIN=drivers.ffgarage.invalid
